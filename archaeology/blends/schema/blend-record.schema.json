{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Valar05/pose-lab-v2/archaeology/blends/schema/blend-record.schema.json",
  "title": "Pose Lab Blend Archaeology Record",
  "type": "object",
  "required": [
    "schema",
    "slug",
    "source",
    "identity",
    "evidence",
    "motionGrammar",
    "lessons",
    "summary"
  ],
  "properties": {
    "schema": { "const": "pose-lab-blend-archaeology-v1" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "source": {
      "type": "object",
      "required": ["filename"],
      "properties": {
        "filename": { "type": "string" },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "sourceDate": { "type": ["string", "null"] },
        "blenderVersion": { "type": ["string", "null"] },
        "provenance": { "type": "string", "enum": ["original-source", "recovered-source", "derivative", "export", "unknown"] },
        "locationNote": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": ["project", "subject"],
      "properties": {
        "project": { "type": ["string", "null"] },
        "subject": { "type": ["string", "null"] },
        "role": { "type": ["string", "null"] },
        "medium": { "type": "string", "enum": ["game", "animation", "character", "tool", "film", "experiment", "unknown"] }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["status", "claim"],
        "properties": {
          "status": { "type": "string", "enum": ["OBSERVED", "MEASURED", "USER_MEMORY", "INFERRED", "VERIFIED", "UNKNOWN"] },
          "claim": { "type": "string" },
          "source": { "type": ["string", "null"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "inventory": {
      "type": "object",
      "properties": {
        "scenes": { "type": "array", "items": { "type": "string" } },
        "collections": { "type": "array", "items": { "type": "string" } },
        "armatures": { "type": "array", "items": { "type": "string" } },
        "actions": { "type": "array", "items": { "type": "string" } },
        "cameras": { "type": "array", "items": { "type": "string" } },
        "notableObjects": { "type": "array", "items": { "type": "string" } },
        "notableConstraints": { "type": "array", "items": { "type": "string" } },
        "notableModifiers": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "productionMethod": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["fully-authored", "mocap-derived", "mocap-key-reduction", "retimed-source", "retargeted", "procedural", "hybrid", "unknown"] },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "motionGrammar": {
      "type": "object",
      "required": ["verbs"],
      "properties": {
        "verbs": { "type": "array", "minItems": 1, "maxItems": 7, "items": { "type": "string" } },
        "worldLaws": { "type": "array", "maxItems": 4, "items": { "type": "string" } },
        "invariants": { "type": "array", "maxItems": 5, "items": { "type": "string" } },
        "channels": { "type": "array", "items": { "type": "string", "enum": ["BODY", "ROOT", "PROP", "TARGET", "CAMERA", "ENVIRONMENT", "TIMING", "DEFORMATION", "GAMEPLAY_STATE", "SOUND_VFX"] } },
        "timingCharacter": { "type": ["string", "null"] },
        "squashStretch": { "type": ["string", "null"] },
        "recoveryLaw": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["mechanism", "consequence"],
        "properties": {
          "mechanism": { "type": "string" },
          "evidence": { "type": "string" },
          "consequence": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["direction", "target", "relationship"],
        "properties": {
          "direction": { "type": "string", "enum": ["ancestor-of", "descendant-of", "echoes", "contrasts-with"] },
          "target": { "type": "string" },
          "relationship": { "type": "string" },
          "status": { "type": "string", "enum": ["OBSERVED", "USER_MEMORY", "INFERRED", "VERIFIED"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["mechanism", "strongestLesson", "futureUse"],
      "properties": {
        "mechanism": { "type": "string", "maxLength": 300 },
        "strongestLesson": { "type": "string", "maxLength": 500 },
        "futureUse": { "type": "string", "maxLength": 500 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
