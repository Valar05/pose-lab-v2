{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pose-lab.invalid/schemas/vanguard-sprite-refinery-batch-v1.schema.json",
  "title": "Vanguard sprite refinery batch",
  "type": "object",
  "required": ["schema", "batchId", "maxConcurrency", "concept", "clips"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "vanguard-sprite-refinery-batch-v1"},
    "batchId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "maxConcurrency": {"type": "integer", "minimum": 1, "maximum": 8},
    "concept": {
      "type": "object",
      "required": ["id", "sha256", "target"],
      "properties": {
        "id": {"const": "file_00000000500881f4adab6e2f24ce0c7d"},
        "sha256": {"const": "a81310b22ed537ec0aac39133bcf810d965ff2f2d00d7f9a8a56472c04c6878e"},
        "target": {"const": "public/assets/vanguard/concepts/fleshpunk-vanguard-v1.jpg"}
      }
    },
    "clips": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "nativeAction", "frameSamples", "timingMs", "facing", "cameraProfile", "grid", "posePacket"],
        "properties": {
          "id": {"type": "string"}, "nativeAction": {"type": "string"},
          "frameSamples": {"type": "array", "items": {"type": "integer", "minimum": 0}},
          "timingMs": {"type": "array", "items": {"type": "integer", "minimum": 1}},
          "facing": {"const": "screen-right"},
          "cameraProfile": {"const": "vanguard-orthographic-screen-right-v1"},
          "grid": {"type": "object", "required": ["columns", "rows"], "properties": {"columns": {"type": "integer", "minimum": 1}, "rows": {"type": "integer", "minimum": 1}}},
          "posePacket": {"type": "string"}
        }
      }
    }
  }
}
